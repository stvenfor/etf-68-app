{
  "name": "etf-68-app",
  "version": "1.0.0",
  "private": true,
  "description": "Mac desktop app for 68-ETF daily technical review",
  "author": "local",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --config desktop/vite.config.ts",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build --config desktop/vite.config.ts",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "engine:check": "cd engine && python3.12 cli_app.py check-python",
    "engine:assemble": "cd engine && python3.12 cli_app.py assemble",
    "engine:generate": "cd engine && python3.12 cli_app.py generate",
    "engine:tts-deps": "python3.12 -m pip install -r engine/requirements.txt"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
